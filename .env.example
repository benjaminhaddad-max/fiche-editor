# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Identite de Diploma Sante (destinataire des factures) ----------
# Ces valeurs apparaissent dans le bloc "Facture a" du PDF.
NEXT_PUBLIC_COMPANY_NAME=Diploma Santé
NEXT_PUBLIC_COMPANY_LEGAL_FORM=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_POSTAL_CODE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_SIRET=
NEXT_PUBLIC_COMPANY_VAT=

# ---------- Pennylane ----------
# Token OAuth (scopes : supplier_invoices:all, file_attachments:all).
# Laisser vide desactive proprement la synchronisation.
PENNYLANE_API_TOKEN=
PENNYLANE_API_URL=https://app.pennylane.com/api/external/v2

# ---------- Brevo (emails transactionnels et relances) ----------
# Cle API v3 : https://app.brevo.com/settings/keys/api
# Laisser vide desactive proprement les envois (journalises en "skipped").
BREVO_API_KEY=
BREVO_SENDER_NAME=Diploma Santé — Facturation
BREVO_SENDER_EMAIL=contact@diploma-sante.fr

# URL publique de la plateforme, utilisee dans les liens des emails.
NEXT_PUBLIC_APP_URL=https://diploma-invoice.vercel.app

# Relances : delai avant premiere relance, et nombre maximum.
RELANCE_DELAY_DAYS=5
RELANCE_MAX=3
